{
  "name": "ro-screen-share",
  "version": "1.0.0",
  "description": "Rank Orbit — Employee Screen Share Client",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build:win":   "electron-builder --win",
    "build:mac":   "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId":       "com.rankorbit.screenshare",
    "productName": "RO Screen Share",
    "files": ["src/**/*"],
    "win": {
      "target": "nsis",
      "icon":   "src/assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon":   "src/assets/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon":   "src/assets/icon.png"
    },
    "nsis": {
      "oneClick":        false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "pusher-js": "^8.5.0"
  },
  "devDependencies": {
    "electron":         "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}
