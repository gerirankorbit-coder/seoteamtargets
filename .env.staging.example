# Reference only — `npm run dev:staging` creates .env.staging (git-ignored) automatically
# for the local staging database. Edit it only for the optional hosted setup in STAGING.md.
# Never paste production database names or production keys here.

APP_ENV=staging
PORT=3001

# The database name MUST contain "staging". Local default shown; a hosted cluster also works.
MONGODB_URI=mongodb://127.0.0.1:27018/
MONGODB_DB_NAME=rankorbit_staging

SESSION_SECRET=<any-long-random-string-different-from-production>

# Optional — password for the seeded test.* users (default: staging-test-123)
STAGING_TEST_PASSWORD=

