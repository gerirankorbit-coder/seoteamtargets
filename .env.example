# Environment variables for Rank Orbit. Names only — never commit real values.
# Production values live in the Vercel project settings; local values go in .env (git-ignored).

# Required
MONGODB_URI=            # MongoDB connection string
SESSION_SECRET=         # long random string used to sign login cookies
                        # (if unset, one is derived from MONGODB_URI)

# Optional
PORT=                   # local port (default 3000)
MONGODB_DB_NAME=        # override the database name from MONGODB_URI
SEED_USER_PASSWORDS=    # JSON {"username":"password"} — initial passwords, used ONLY to
                        # create accounts from the team list that are not in the database yet

# Staging only (see STAGING.md)
APP_ENV=                # "staging" for a staging run
STAGING_TEST_PASSWORD=  # password for the seeded test.* accounts (default: staging-test-123)

# Set automatically by Vercel — do not set by hand
# VERCEL_ENV, VERCEL_GIT_COMMIT_REF
